# コピーして .env.local（ローカル）または本番 .env に設定してください。
# 実際の値はリポジトリにコミットしないでください。

# --- データベース（MySQL）---
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/tcc"

# --- 認証（マジックリンク・セッション）---
# 32文字以上のランダム文字列（openssl rand -base64 32）
AUTH_SECRET="CHANGE_ME_USE_openssl_rand_base64_32"

# ブラウザからアクセスする公開 URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- SMTP（外部メールサーバー）---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@example.com"
