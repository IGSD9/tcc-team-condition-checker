{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && prisma migrate deploy && next build",
    "build:prod": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "verify:env": "node scripts/verify-env.mjs",
    "deploy:first": "bash deploy/scripts/first-deploy.sh",
    "deploy:update": "bash deploy/scripts/deploy.sh",
    "deploy:nginx": "bash deploy/scripts/setup-nginx.sh",
    "deploy:ui-check": "bash deploy/scripts/finish-ui-check.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "lucide-react": "^1.14.0",
    "nodemailer": "^7.0.3",
    "next": "16.2.4",
    "mysql2": "^3.14.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
