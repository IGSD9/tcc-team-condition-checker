# EC2 本番用。コピー: cp deploy/env.production.example .env

NODE_ENV=production
PORT=3000

DATABASE_URL="mysql://root:Tcc1234!@localhost:3306/tcc"

# openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_32_CHARS_OR_MORE"

NEXT_PUBLIC_SITE_URL="http://3.112.239.24"

# 見た目確認のみ: 1 にすると SMTP チェックをスキップ（ログインは使えない）
SKIP_SMTP_VERIFY=1

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@your-domain.example"
